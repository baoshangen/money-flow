# SPA fallback: mọi đường dẫn trỏ về index.html để React Router xử lý
# (tránh lỗi 404 khi refresh trang con). Hostinger (LiteSpeed/Apache) đọc file này.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
